+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#include <string.h>
+
+#include "reorder.h"
+
+#define SN_MASK 0x0fff
+#define SN_HALF 0x0800
+
+/* How far sn is ahead of base, modulo the 12-bit sequence space; SN_HALF or
+ * more means it is behind. */
+static uint16_t sn_ahead(uint16_t sn, uint16_t base) {
+	return (uint16_t) ((sn - base) & SN_MASK);
+}
+
+static struct reorder_slot *slot_of(struct reorder_session *s, uint16_t sn) {
+	return &s->slot[sn % REORDER_WINDOW];
+}
+
+static void free_slot(struct reorder_slot *slot) {
+	for (int i = 0; i < slot->count; i++)
+		buf_free(slot->frames[i]);
+	slot->count = 0;
+}
+
+static void deliver_slot(struct reorder_session *s, struct reorder_slot *slot,
+                         reorder_deliver_cb deliver, void *arg) {
+	for (int i = 0; i < slot->count; i++)
+		deliver(slot->frames[i], arg);
+	slot->count = 0;
+	s->held--;
+}
+
+/* Deliver from head while the next frame is here. */
+static void release_in_order(struct reorder_session *s, reorder_deliver_cb deliver, void *arg) {
+	struct reorder_slot *slot;
+
+	while ((slot = slot_of(s, s->head))->count) {
+		deliver_slot(s, slot, deliver, arg);
+		s->head = (uint16_t) ((s->head + 1) & SN_MASK);
+	}
+}
+
+/* Move head to new_head, delivering what is held on the way and skipping
+ * the gaps, then whatever follows in order. */
+static void advance(struct reorder_session *s, uint16_t new_head, reorder_deliver_cb deliver, void *arg) {
+	while (s->head != new_head) {
+		struct reorder_slot *slot = slot_of(s, s->head);
+		if (slot->count)
+			deliver_slot(s, slot, deliver, arg);
+		s->head = (uint16_t) ((s->head + 1) & SN_MASK);
+	}
+	release_in_order(s, deliver, arg);
+}
+
+static void flush(struct reorder_session *s, reorder_deliver_cb deliver, void *arg) {
+	if (s->held)
+		advance(s, (uint16_t) ((s->head + s->size) & SN_MASK), deliver, arg);
+}
+
+static struct reorder_session *find(struct reorder_state *r, const struct ether_addr *peer, uint8_t tid) {
+	for (int i = 0; i < REORDER_SESSIONS; i++) {
+		struct reorder_session *s = &r->session[i];
+		if (s->active && s->tid == tid && !memcmp(&s->peer, peer, sizeof(*peer)))
+			return s;
+	}
+	return NULL;
+}
+
+void reorder_init(struct reorder_state *r) {
+	memset(r, 0, sizeof(*r));
+}
+
+void reorder_start(struct reorder_state *r, const struct ether_addr *peer, uint8_t tid, uint16_t size, uint16_t ssn,
+                   reorder_deliver_cb deliver, void *arg) {
+	struct reorder_session *s = find(r, peer, tid);
+
+	if (s) {
+		flush(s, deliver, arg);
+	} else {
+		for (int i = 0; i < REORDER_SESSIONS && !s; i++)
+			if (!r->session[i].active)
+				s = &r->session[i];
+		if (!s) {
+			/* Full: replace the first, delivering what it holds. */
+			s = &r->session[0];
+			flush(s, deliver, arg);
+		}
+	}
+	memset(s, 0, sizeof(*s));
+	s->active = 1;
+	s->peer = *peer;
+	s->tid = tid;
+	s->size = size == 0 || size > REORDER_WINDOW ? REORDER_WINDOW : size;
+	s->head = (uint16_t) (ssn & SN_MASK);
+}
+
+void reorder_stop(struct reorder_state *r, const struct ether_addr *peer, uint8_t tid,
+                  reorder_deliver_cb deliver, void *arg) {
+	struct reorder_session *s = find(r, peer, tid);
+
+	if (!s)
+		return;
+	flush(s, deliver, arg);
+	s->active = 0;
+}
+
+int reorder_rx(struct reorder_state *r, const struct ether_addr *peer, uint8_t tid, uint16_t sn,
+               struct buf **frames, int count, uint64_t now, reorder_deliver_cb deliver, void *arg) {
+	struct reorder_session *s = find(r, peer, tid);
+	struct reorder_slot *slot;
+	uint16_t ahead;
+
+	if (!s || count <= 0 || count > REORDER_MAX_FRAMES)
+		return 0;
+	sn &= SN_MASK;
+	ahead = sn_ahead(sn, s->head);
+	if (ahead >= SN_HALF) {
+		/* Behind the window: delivered already, or given up on. */
+		for (int i = 0; i < count; i++)
+			buf_free(frames[i]);
+		r->stats.dropped_old++;
+		return 1;
+	}
+	if (ahead >= s->size) /* past the window: it moves up so sn is its last */
+		advance(s, (uint16_t) ((sn - s->size + 1) & SN_MASK), deliver, arg);
+
+	slot = slot_of(s, sn);
+	if (slot->count) {
+		for (int i = 0; i < count; i++)
+			buf_free(frames[i]);
+		r->stats.dropped_duplicate++;
+		return 1;
+	}
+	if (sn != s->head)
+		r->stats.held++;
+	else if (s->held)
+		r->stats.delivered_late++; /* fills the gap others were waiting on */
+	memcpy(slot->frames, frames, sizeof(*frames) * count);
+	slot->count = count;
+	slot->since = now;
+	s->held++;
+	release_in_order(s, deliver, arg);
+	return 1;
+}
+
+void reorder_bar(struct reorder_state *r, const struct ether_addr *peer, uint8_t tid, uint16_t ssn,
+                 reorder_deliver_cb deliver, void *arg) {
+	struct reorder_session *s = find(r, peer, tid);
+	uint16_t ahead;
+
+	if (!s)
+		return;
+	ahead = sn_ahead((uint16_t) (ssn & SN_MASK), s->head);
+	if (ahead == 0 || ahead >= SN_HALF)
+		return;
+	if (s->held)
+		r->stats.released_by_bar++;
+	advance(s, (uint16_t) (ssn & SN_MASK), deliver, arg);
+}
+
+void reorder_expire(struct reorder_state *r, uint64_t now, uint64_t timeout_us,
+                    reorder_deliver_cb deliver, void *arg) {
+	for (int i = 0; i < REORDER_SESSIONS; i++) {
+		struct reorder_session *s = &r->session[i];
+		int last = -1;
+
+		if (!s->active || !s->held)
+			continue;
+		for (int k = 0; k < s->size; k++) {
+			struct reorder_slot *slot = slot_of(s, (uint16_t) ((s->head + k) & SN_MASK));
+			if (slot->count && now - slot->since >= timeout_us)
+				last = k;
+		}
+		if (last >= 0) {
+			r->stats.released_by_timeout++;
+			advance(s, (uint16_t) ((s->head + last + 1) & SN_MASK), deliver, arg);
+		}
+	}
+}
+
+void reorder_free(struct reorder_state *r) {
+	for (int i = 0; i < REORDER_SESSIONS; i++)
+		for (int k = 0; k < REORDER_WINDOW; k++)
+			free_slot(&r->session[i].slot[k]);
+	memset(r, 0, sizeof(*r));
+}
diff --git a/src/reorder.h b/src/reorder.h
new file mode 100644
index 0000000..567d873
--- /dev/null
+++ b/src/reorder.h
@@ -0,0 +1,97 @@
+/*
+ * OWL: an open Apple Wireless Direct Link (AWDL) implementation
+ * Copyright (C) 2018  The Open Wireless Link Project (https://owlink.org)
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+/*
+ * Receive reordering for a Block Ack session (802.11-2016 10.24.7), what
+ * mac80211 does for a station and nothing does for OWL's monitor interface.
+ * In an A-MPDU the subframes the receiver missed come again in a later
+ * burst, so without this they reach TCP behind the ones that followed them:
+ * with -A, 57% of an iPhone's segments arrived past a gap and 43% of our
+ * ACKs were duplicates (2026-10-14). Frames are held per peer and TID until
+ * the gap fills, the window moves past it, a Block Ack Request says the
+ * sender gave up on it, or it has waited REORDER_TIMEOUT_US.
+ */
+
+#ifndef AWDL_REORDER_H_
+#define AWDL_REORDER_H_
+
+#include <stdint.h>
+
+#include "wire.h"
+
+#define REORDER_SESSIONS 4
+#define REORDER_WINDOW 64 /* the most an ADDBA Response of ours offers */
+#define REORDER_MAX_FRAMES 16 /* per sequence number: an A-MSDU's subframes */
+#define REORDER_TIMEOUT_US 100000 /* mac80211's HT_RX_REORDER_BUF_TIMEOUT */
+
+typedef void (*reorder_deliver_cb)(struct buf *frame, void *arg);
+
+struct reorder_slot {
+	struct buf *frames[REORDER_MAX_FRAMES];
+	int count;
+	uint64_t since;
+};
+
+struct reorder_session {
+	int active;
+	struct ether_addr peer;
+	uint8_t tid;
+	uint16_t head; /* the next sequence number to deliver */
+	uint16_t size; /* the window agreed in the ADDBA Response */
+	int held;
+	struct reorder_slot slot[REORDER_WINDOW];
+};
+
+struct reorder_state {
+	struct reorder_session session[REORDER_SESSIONS];
+	struct {
+		unsigned long held, delivered_late, dropped_old, dropped_duplicate, released_by_timeout, released_by_bar;
+	} stats;
+};
+
+void reorder_init(struct reorder_state *r);
+
+/* Start (or restart) the session with peer for tid, the window size frames
+ * wide, from starting sequence number ssn (the ADDBA Request's). Frames held
+ * by a session it replaces are delivered first. */
+void reorder_start(struct reorder_state *r, const struct ether_addr *peer, uint8_t tid, uint16_t size, uint16_t ssn,
+                   reorder_deliver_cb deliver, void *arg);
+
+/* End the session (DELBA), delivering what it holds. */
+void reorder_stop(struct reorder_state *r, const struct ether_addr *peer, uint8_t tid,
+                  reorder_deliver_cb deliver, void *arg);
+
+/* A QoS data frame from peer for tid with sequence number sn, already
+ * converted to the count Ethernet frames in frames. Returns 0 if there is no
+ * session for it: the caller delivers the frames itself. Returns 1 if the
+ * frames were taken: delivered now, in order, held, or freed as stale. */
+int reorder_rx(struct reorder_state *r, const struct ether_addr *peer, uint8_t tid, uint16_t sn,
+               struct buf **frames, int count, uint64_t now, reorder_deliver_cb deliver, void *arg);
+
+/* A Block Ack Request: the sender won't send anything before ssn again. */
+void reorder_bar(struct reorder_state *r, const struct ether_addr *peer, uint8_t tid, uint16_t ssn,
+                 reorder_deliver_cb deliver, void *arg);
+
+/* Deliver what has waited timeout_us or longer, and everything before it. */
+void reorder_expire(struct reorder_state *r, uint64_t now, uint64_t timeout_us,
+                    reorder_deliver_cb deliver, void *arg);
+
+/* Free everything held, undelivered. */
+void reorder_free(struct reorder_state *r);
+
+#endif /* AWDL_REORDER_H_ */
