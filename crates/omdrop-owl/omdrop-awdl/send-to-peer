#!/usr/bin/env python3
"""Send files to an AWDL peer without waiting for an mDNS advert.

2026-09-18: two transfers landed on a Mac by dialling its EUI-64 link-local
directly. Discovery was never the problem and mDNS was never the channel -- a
Mac in Everyone mode answers /Discover with no Finder AirDrop window open and
publishes no `_airdrop._tcp` instance at all, so a sender that waits for one
waits forever. The firmware peer table already holds every MAC we can hear,
and a link-local address is a pure function of a MAC, so the endpoint needs no
discovery protocol.

  tools/send-to-peer --list                 # what can we hear, and where
  tools/send-to-peer FILE                   # the only peer, or --mac to choose
  tools/send-to-peer --mac e2:9d:.. FILE
  tools/send-to-peer --mac hume --url https://example.com/   # a link, opened there
  tools/send-to-peer --print FILE           # show the command, send nothing

Peers come from `awdl-discoverable peers`, which needs root, so this runs it
through pkexec. Everything else runs as you.
"""
import argparse
import concurrent.futures
import contextlib
import os
import re
import select
# `signal` is taken by the dBm formatter below, and a module shadowed by a
# function defined 200 lines later fails only at the moment it is used.
import signal as signals
import socket
import subprocess
import sys
import time

TOOLS = os.path.dirname(os.path.abspath(__file__))
HELPER = os.path.join(TOOLS, "omdrop-discoverable")
SENDER = os.path.join(TOOLS, "airdrop-send.py")
ADVERTISER = os.path.join(TOOLS, "ble-airdrop-adv.py")
AIRDROP_PORT = 8770
# A peer that serves AirDrop on a port of its own, as Android's Quick Share
# does with a random one, announces it only in its AWDL action frames. The
# helper's `peers` reports it as `port=N`; Apple devices announce nothing and
# are dialled on AIRDROP_PORT. Replaced whole on every read of the table.
PORTS = {}
IFACE = "awdl0"
# The advert's ceiling for a name lookup, and the deadline its knocks wait to.
# Not a sleep. The receiver binds its port in milliseconds; reaching it took
# 14.8 s in the run that worked, so the knock keeps trying to this deadline
# instead of guessing how long to wait. There is nothing to wait for once we
# stop transmitting. A send waits, and advertises, for its own --wait.
WAKE_SECONDS = 30
WAKE_READY = 5.0       # how long to wait for the advertiser to say it registered
# Android closes its AirDrop receiver about ten seconds after our BLE wake
# stops, and a send has to outlast that: the person accepts it on the phone
# first. So a send to a peer that announced its own port keeps the wake up
# through the wait and until the sender exits, to the wait plus this (the
# proven run, 30.4 MB, took 10 s).
# shortcut: a transfer that outlasts this loses the wake; restart the advert
# before the ceiling if that ever matters.
SEND_WAKE_SECONDS = 300


def _wake_start(seconds=WAKE_SECONDS):
    """Start the advert and wait for BlueZ to accept it, or explain why not.

    Returns (proc, note). A note is a redacted one-line reason the wake did
    not happen; None means it did. The advertiser prints `START ...` once
    LEAdvertisingManager1 has taken the advertisement and `REGISTER FAILED`
    when it has not, so registration is observed rather than assumed -- a live
    pid proves only that python started, and a D-Bus or identity error would
    otherwise look exactly like a working wake.

    Without an Apple ID record the advertiser sends zero hashes. That wakes a
    receiver set to Everyone (measured on a Mac, 2026-09-21, and an iPhone,
    2026-09-28) and nothing set to Contacts Only; skipping the advert instead
    meant a machine with only a self-signed identity never woke anything at all.
    """
    if not os.path.exists(ADVERTISER):
        return None, None                      # not installed; nothing to say
    try:
        proc = subprocess.Popen(
            [sys.executable, ADVERTISER, "--arm", "A",
             "--seconds", str(max(1, int(seconds))), "--interval-ms", "100"],
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, bufsize=0)
    except OSError as e:
        return None, f"wake not started: {e.strerror}"

    # Raw bytes, and every complete line in hand is examined before waiting for
    # the fd again. select() answers about the PIPE, not about Python's buffer,
    # and the advertiser prints its hash-source line and START in one flush --
    # so a readline() that swallowed both would leave select() with nothing to
    # report and time out five seconds after the advert was already up.
    # Reading in chunks also means a partial line never blocks.
    #
    # An interrupt anywhere below would strand a transmitting child the caller
    # has never seen: the pid lives in this frame until it returns.
    try:
        deadline = time.monotonic() + WAKE_READY
        fd = proc.stdout.fileno()
        os.set_blocking(fd, False)
        buf, last, eof = b"", "", False
        while True:
            while b"\n" in buf:
                raw, buf = buf.split(b"\n", 1)
                line = raw.decode("utf-8", "replace").strip()
                if not line:
                    continue
                last = line
                if " START " in line:
                    # Registration is the start of the window, not a moment to
                    # sleep through: the peers are polled from here.
                    return proc, None
                if "FAILED" in line:
                    return proc, f"wake not advertising: {last}"
            if eof or proc.poll() is not None:
                # Drain first: the reason it died is the last thing it said.
                if not eof:
                    try:
                        buf += proc.stdout.read() or b""
                    except (BlockingIOError, ValueError):
                        pass
                    eof = True
                    continue
                proc.wait()
                return None, f"wake exited: {last or 'no output'}"
            left = deadline - time.monotonic()
            if left <= 0:
                return proc, f"wake did not register within {WAKE_READY:.0f}s"
            if select.select([fd], [], [], left)[0]:
                chunk = os.read(fd, 4096)
                if not chunk:
                    eof = True
                else:
                    buf += chunk
    except BaseException:
        _wake_stop(proc)
        raise


def _wake_stop(proc):
    """Stop the advert and reap it, so BlueZ drops the advertisement now."""
    if proc is None or proc.poll() is not None:
        return
    proc.terminate()
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait()


@contextlib.contextmanager
def wake(seconds=WAKE_SECONDS, purpose="naming peers that are already listening"):
    """Advertise ourselves over BLE for as long as we are asking peers to talk.

    A Contacts Only device keeps its AirDrop server shut until a sender's BLE
    Continuity advert presents contact hashes it recognizes. Measured against a
    Mac on 2026-09-21: with zero hashes it logged the advert UNRECOGNIZED and
    started nothing, so every lookup got a refusal or silence; with this
    account's own hashes it recognized them at 19:03:18.644, bound 8770 at
    .666, and the same listing that had failed all day returned the peer's
    name. Without this, `-n` works only against a device something else woke.

    Bounded on purpose, and the bound must survive an interrupt: everything
    from the spawn onwards is inside the try, because a Ctrl-C during startup
    used to leave the advert running until its own --seconds expired. SIGTERM
    is turned into SystemExit for the same reason -- the default disposition
    kills this process without unwinding, orphaning a radio that is
    transmitting.

    Silent when there is nothing to run: a machine without the advertiser
    still names a peer something else has woken. A wake that was supposed to
    work and did not is the opposite case, and says so on stderr, followed by
    `purpose`: what the caller carries on doing without it.

    Yields the absolute deadline the wake lasts until, or None when no wake of
    ours is up and there is nothing to wait for.
    """
    proc = None
    previous = signals.getsignal(signals.SIGTERM)

    def _term(*_):
        raise SystemExit(143)

    try:
        signals.signal(signals.SIGTERM, _term)
    except ValueError:
        previous = None                        # not the main thread; nothing to restore
    try:
        proc, note = _wake_start(seconds)
        if note:
            print(f"{note}; {purpose}", file=sys.stderr)
        yield (time.monotonic() + seconds) if proc is not None and not note else None
    finally:
        _wake_stop(proc)
        if previous is not None:
            signals.signal(signals.SIGTERM, previous)


def link_local(mac):
    """MAC -> EUI-64 link-local, the address an Apple peer answers on.

    fe80:: + the MAC with its universal/local bit flipped and ff:fe in the
    middle. e2:9d:03:6c:58:23 -> fe80::e09d:3ff:fe6c:5823, which is exactly
    what the Mac reported for itself.
    """
    b = [int(x, 16) for x in mac.split(":")]
    if len(b) != 6:
        raise ValueError(f"not a MAC: {mac}")
    b[0] ^= 0x02
    eui = b[:3] + [0xFF, 0xFE] + b[3:]
    groups = [f"{eui[i] << 8 | eui[i + 1]:x}" for i in range(0, 8, 2)]
    return "fe80::" + ":".join(groups)


class HelperFailed(Exception):
    """The peer table could not be read at all, which is not an empty room."""


def peers():
    """Every MAC the firmware can currently hear, strongest signal first.

    Reading the table needs root, so it goes through the helper. Two failures
    look identical in the output and are not: a room with nobody in it, and a
    helper that never ran. Reporting the second as the first sent a debugging
    session after the radio when the real answer was polkit (2026-09-18).

    polkit grants this without a password only to a session on a seat. Over
    SSH there is no seat, so `pkexec` prompts and then fails with "No session
    for cookie" -- the password is never even checked. `sudo` does not involve
    polkit and works there.
    """
    run = subprocess.run(["pkexec", HELPER, "peers"], capture_output=True, text=True)
    if run.returncode != 0:
        detail = (run.stderr or run.stdout).strip().splitlines()
        hint = ""
        if not on_a_seat():
            hint = (f"\nThis session has no seat, so polkit will not authorize it. Use:"
                    f"\n  sudo {HELPER} peers")
        raise HelperFailed(
            f"could not read the peer table ({HELPER} exited {run.returncode})"
            + (f": {detail[-1]}" if detail else "") + hint)
    found, ports = {}, {}
    for line in run.stdout.splitlines():
        m = re.search(r"([0-9a-f]{2}(?::[0-9a-f]{2}){5})\s+rssi=\s*(-?\d+)", line)
        if m:
            found[m.group(1)] = int(m.group(2))
        m = re.match(r"((?:[0-9a-f]{2}:){5}[0-9a-f]{2})\s.*\bport=(\d+)", line)
        if m:
            ports[m.group(1)] = int(m.group(2))
    # The advertisers table is a live snapshot and it empties between reads:
    # sampled every four seconds on 2026-09-20 it reported nobody in four reads
    # out of five while three peers were registered and audible. On its own it
    # makes a room full of devices look empty.
    #
    # The peer watcher's registrations are the durable record: it pins one
    # neighbour per peer it has heard during this window and releases them when
    # the window closes. A peer seen only there has no RSSI, which is worth
    # saying rather than inventing a number.
    for mac in registered_peers():
        found.setdefault(mac, None)
    # Both sources can include this machine's own AWDL address, which would
    # then list as a peer (issue 12). No interface, no address to drop.
    own = own_address()
    if own:
        found.pop(own, None)
    # A read can show a peer without the port it announced earlier, and that
    # peer may already have answered on it. Keep a port for as long as its
    # peer is in the table; drop it with the peer.
    global PORTS
    PORTS = {mac: p for mac, p in PORTS.items() if mac in found} | ports
    return sorted(found.items(), key=lambda p: (p[1] is None, -(p[1] or 0)))


def own_address():
    """This machine's MAC on IFACE, or None when the interface is absent."""
    try:
        with open(f"/sys/class/net/{IFACE}/address") as f:
            return f.read().strip().lower()
    except OSError:
        return None


def registered_peers():
    """MACs the peer watcher has pinned on awdl0 this window. Needs no root."""
    # nud permanent, because that is what the watcher writes. Without the
    # filter this also returns FAILED entries the kernel created from our own
    # unanswered probes, which then appear in the listing as peers that were
    # never registered and are not there.
    run = subprocess.run(["ip", "-6", "neigh", "show", "dev", IFACE, "nud", "permanent"],
                         capture_output=True, text=True)
    return re.findall(r"lladdr\s+([0-9a-f]{2}(?::[0-9a-f]{2}){5})", run.stdout)


def signal(rssi):
    """A peer registered this window but absent from the current advertisers
    snapshot has no signal reading. Say so; a fabricated number would be worse
    than a blank."""
    return f"{rssi:>4} dBm" if rssi is not None else "   ? dBm"


def on_a_seat():
    """Is this a local session polkit will treat as active?

    Only a seated session gets allow_active. A remote or seatless one falls to
    allow_any, which this action deliberately sets to auth_admin.
    """
    run = subprocess.run(["loginctl", "show-session", os.environ.get("XDG_SESSION_ID", ""),
                          "-p", "Seat"], capture_output=True, text=True)
    if run.returncode == 0 and "Seat=" in run.stdout:
        return run.stdout.strip() != "Seat="
    # No session id to ask about: assume seatless and offer the sudo hint,
    # which is wrong only in the harmless direction.
    return bool(os.environ.get("XDG_SEAT"))


def listening(host, port, timeout=2.0):
    """Is anything accepting TCP there right now?

    A refusal is an answer, not a failure: it means the peer's stack replied,
    so the radio path is fine and only the service is absent.
    """
    addr = socket.getaddrinfo(f"{host}%{IFACE}", port,
                              socket.AF_INET6, socket.SOCK_STREAM)[0][4]
    s = socket.socket(socket.AF_INET6, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(addr)
        return True
    except OSError:
        return False
    finally:
        s.close()


def _knock(mac, port, ready_by=None):
    """Wait for a peer's AirDrop port to answer, up to an absolute deadline.

    Two knocks when there is no deadline, which is what --no-wake and a failed
    advert get: without a wake of our own there is nothing to wait for, and an
    absent peer should cost a listing seconds rather than half a minute.

    With a deadline, every socket wait is capped by the time left, so this can
    overrun neither the wake's own ceiling nor the caller's cap. A refusal
    comes back instantly and means the stack is there and the service is not,
    so it is paced rather than spun on.
    """
    host = link_local(mac)
    if ready_by is None:
        return any(listening(host, PORTS.get(mac, port), timeout=3.0) for _ in range(2))
    while True:
        left = ready_by - time.monotonic()
        if left <= 0:
            return False
        t0 = time.monotonic()
        if listening(host, PORTS.get(mac, port), timeout=min(3.0, left)):
            return True
        # An immediate answer means a refusal, not a timeout: sleep the
        # difference so a refusing peer is polled, not hammered.
        spent = time.monotonic() - t0
        if spent < 1.0:
            time.sleep(min(1.0 - spent, max(0.0, ready_by - time.monotonic())))


def peer_name(mac, port, sender_name, timeout=8.0, ready_by=None):
    """Ask one peer what it calls itself.

    Returns the name, "" when the peer answered without naming itself, and
    None when it did not answer at all. Those are different facts and a person
    reading a listing needs to tell them apart: an iPhone only keeps its
    AirDrop server up in bursts, so "not listening" is routine and says
    nothing about whether the peer would accept a file a moment later.

    Runs the sender in --discover-only mode rather than reimplementing the
    request: the identity record, the TLS material and the /Discover body all
    live there, and a second copy of them would drift.
    """
    # A cheap TCP knock first. Spawning the sender costs a python start, TLS
    # material and two attempts, and for a device that is not receiving all of
    # that is spent to learn what one refused connection says in a moment:
    # six peers took 49 s before this, and under 2 s after.
    # Twice: a single 1.5 s knock is not a reliable test of a listening peer.
    # Measured against a Mac with sharingd bound to *:8770, one knock in six
    # timed out and the lookup reported a receiving device as absent without
    # ever asking it. Two knocks cost an absent peer 3 s instead of 1.5 s,
    # which is still a listing in seconds rather than the 49 s it took before
    # any knock existed.
    # Even two knocks miss: measured 1 in 8 against a Mac with sharingd bound
    # to *:8770, because the knock lands while it is restarting its Bonjour
    # server. So a failed knock downgrades the budget rather than deciding the
    # answer -- one ask is still made, because reporting a receiving device as
    # absent without asking it is the error that matters. An absent peer pays
    # a few seconds; a present one is never dismissed unasked.
    # 3 s, not 1.5: the FIRST connection to an idle Mac takes about a second
    # and sometimes longer, while every one after it returns instantly. A 1.5 s
    # knock therefore failed against a peer that was plainly listening -- 3 of 8
    # lookups reported a receiving device as absent -- and the cost of being
    # wrong here is a device you cannot name or send to.
    #
    # ready_by extends that reasoning to a peer we have just woken. The BLE
    # advert is recognized in milliseconds -- hume started its server 0.45 s
    # into the failing call of 2026-09-21T19:23 -- but REACHING the port it
    # binds is a different matter: in the successful run of 19:03 the knock
    # did not answer until 14.8 s after the advert went up, on a listener the
    # receiver's log shows was bound within a millisecond of recognition. So
    # the knock keeps trying until an absolute deadline rather than twice: the
    # bind is instant, the path is not, and two knocks inside seven seconds is
    # how the cold call of 19:23 reported two woken peers as absent.
    knocked = _knock(mac, port, ready_by)
    # A peer that answered a knock gets the full budget; one that ignored two
    # gets a single short ask, so a listing of absent devices stays in seconds.
    attempts, timeout = (3, timeout) if knocked else (1, 3.0)
    # Why three attempts: a lookup against a listening Mac fails sometimes and
    # the CAUSE IS NOT ESTABLISHED. Counts measured 2026-09-20, kept because
    # they are the evidence for the budget rather than for any explanation:
    # knock plus two attempts named it 3 times in 4, two attempts with no knock
    # named it 4 in 4. Those runs were sequential, so order and warm-up are not
    # excluded, and the receiver's own log shows ONE server restart across
    # twelve minutes and 42 completed DISCOVERs -- so a connection does not
    # generally provoke a restart, and the tempting story that the knock eats a
    # sacrificial connection is NOT supported by receiver-side evidence.
    #
    # What the budget rests on is simpler: retries cost little and a wrong
    # "nothing answered" is expensive, because it hides a device you could
    # otherwise name and send to.
    target = f"[{link_local(mac)}%{IFACE}]:{PORTS.get(mac, port)}"
    # Twice, because the first attempt to an Apple peer is unreliable: macOS
    # accepts on identity, restarts its Bonjour server for a peer it classes as
    # legacy, and kills the connection in flight -- the server is ready again
    # milliseconds later. Measured against a receiving Mac 2026-09-20: 6 of 8
    # first attempts answered, 8 of 8 within two, and none needed a third. One
    # retry is the difference between a name and a device that looks asleep.
    for attempt in range(attempts):
        t0 = time.time()
        try:
            r = subprocess.run([sys.executable, SENDER, "--direct", target,
                                "--discover-only", "--name", sender_name,
                                "--op-timeout", str(timeout)],
                               capture_output=True, text=True, timeout=timeout + 4)
            rc, err = r.returncode, (r.stderr or "").strip().splitlines()[-1:] 
        except subprocess.TimeoutExpired:
            rc, err, r = None, ["subprocess timeout"], None
        _trace(mac, attempt + 1, knocked, t0, rc, err)
        if r is not None and r.returncode == 0:
            return r.stdout.strip()
    return None


def _trace(mac, attempt, knocked, t0, rc, err):
    """Append one line per attempt when OMDROP_NAME_LOG names a file.

    Off unless asked for, and it changes no decision: the receiver operator
    needs per-attempt UTC bounds, return codes and stderr to line our failures
    up against their accepts, TLS errors and DISCOVER events, and the return
    value alone throws all of that away.
    """
    path = os.environ.get("OMDROP_NAME_LOG")
    if not path:
        return
    fmt = "%Y-%m-%dT%H:%M:%S.%fZ"
    line = (f"{time.strftime(fmt[:-3], time.gmtime(t0))}Z..{time.strftime(fmt[:-3], time.gmtime())}Z "
            f"mac={mac} attempt={attempt} knocked={int(knocked)} rc={rc} err={err}\n")
    try:
        with open(path, "a") as fh:
            fh.write(line)
    except OSError:
        pass


RESCAN_SECONDS = 2.0   # how often a lookup re-reads the peer table for newcomers


def peer_names(macs, port, sender_name, with_wake=True, on_result=None, rescan=None):
    """Name every peer at once. Serially this costs seconds per peer, and a
    listing is something a person waits on.

    The wake wraps the whole batch rather than each peer: one advert reaches
    every device in range, and the probes are concurrent anyway. They share one
    absolute deadline for the same reason -- it is the advert that is running
    out, not each peer's patience -- so a slow peer cannot push the listing
    past the moment we stop transmitting.

    on_result(mac, name) is called the moment each peer's answer is known, so
    a caller can show a name seconds after it arrives rather than when the
    slowest peer gives up, which is the whole lookup's deadline.

    rescan() returns the macs heard now. While the wake is still up it is
    called every RESCAN_SECONDS and any mac not yet asked is asked in this same
    lookup: the firmware table holds eight entries and churns, and a device
    that arrived just after the lookup started otherwise waited for the next
    one, half a minute later.
    """
    results = {}
    with contextlib.ExitStack() as stack:
        ready_by = stack.enter_context(wake()) if with_wake else None
        # Sixteen covers the eight-entry table plus the watcher's registrations.
        with concurrent.futures.ThreadPoolExecutor(max_workers=16) as pool:
            def ask(m):
                return pool.submit(peer_name, m, port, sender_name, ready_by=ready_by)
            pending = {ask(m): m for m in macs}
            asked = set(macs)
            # An empty table is no reason to stop while the wake is up: an
            # Android phone in Quick Share receive mode joins AWDL only once it
            # hears that wake, so it can't be in the table before the lookup.
            # Only until someone is heard, though: a lookup whose peers all
            # answer returns then, not when the wake runs out.
            while pending or (not asked and rescan and ready_by is not None
                              and time.monotonic() < ready_by):
                if not pending:
                    time.sleep(RESCAN_SECONDS)
                done, _ = concurrent.futures.wait(
                    pending, timeout=RESCAN_SECONDS if rescan else None,
                    return_when=concurrent.futures.FIRST_COMPLETED)
                for f in done:
                    m = pending.pop(f)
                    results[m] = f.result()
                    if on_result:
                        on_result(m, results[m])
                # Newcomers only while we are still transmitting: once the wake
                # ends there is nothing to wake them with, and a lookup without
                # one should stay in seconds.
                if rescan and ready_by is not None and time.monotonic() < ready_by:
                    for m in rescan():
                        if m not in asked:
                            asked.add(m)
                            pending[ask(m)] = m
    return results


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("files", nargs="*", metavar="file",
                    help="files to send, as one transfer the peer accepts once")
    ap.add_argument("--url", action="append", default=[], metavar="URL",
                    help="send this http(s) link instead of files; the peer opens it "
                         "in its browser. Repeat for several")
    ap.add_argument("--mac", metavar="NAME|ADDRESS",
                    help="who to send to: a peer name, or part of its address. "
                         "Default is the only device heard")
    ap.add_argument("--list", action="store_true", help="list peers and their endpoints")
    ap.add_argument("--print", dest="show", action="store_true",
                    help="print the sender command without running it")
    ap.add_argument("--port", type=int, default=AIRDROP_PORT,
                    help="AirDrop port of peers that announce none (Apple's)")
    ap.add_argument("--name", default=socket.gethostname().split(".")[0],
                    help="SenderComputerName the peer shows. Default: the short hostname")
    ap.add_argument("--op-timeout", type=float, default=60.0,
                    help="seconds to wait on each request; /Ask waits for a human")
    ap.add_argument("--wait", type=float, default=0.0, metavar="SECONDS",
                    help="poll the peer's port and send the moment it opens; "
                         "an iPhone only listens in bursts")
    # -n, not --name: --name is already the SenderComputerName this machine
    # presents. A peer's own name is not advertised anywhere -- AirDrop's mDNS
    # instance is a random 12-hex id -- so the only way to learn it is to ask
    # the peer over /Discover. That is an outbound connection which shows this
    # machine's identity to every device in range, so it is opt-in and never
    # happens on a bare listing.
    ap.add_argument("-n", "--names", action="store_true",
                    help="ask each peer for its name over /Discover (reveals this "
                         "machine to every peer listed)")
    # The advert that makes -n work on a Contacts Only device also announces
    # this machine's own contact hashes to everything in BLE range, for as long
    # as the listing runs. That is what an Apple device does the moment its
    # share sheet opens, and -n is already opt-in for the same reason -- but
    # anyone who wants the listing without the broadcast can have it, and will
    # get names only from devices something else has woken.
    ap.add_argument("--no-wake", dest="wake", action="store_false",
                    help="do not advertise over BLE while asking for names or "
                         "waiting to send; only peers already listening answer")
    # For a caller drawing names as they arrive: each peer's row is printed
    # when its answer is known, in that order, instead of all at the end.
    ap.add_argument("--stream", action="store_true",
                    help="with --list --names, print each peer as soon as it answers")
    args = ap.parse_args()

    try:
        heard = peers()
    except HelperFailed as e:
        print(e, file=sys.stderr)
        return 4
    rssi_of = dict(heard)

    # Re-read the table during a lookup: it finds peers that joined after it
    # started, and refreshes PORTS, which _knock reads, for a peer whose port
    # reached the table after the peer did. A failed read is not a reason to
    # stop naming the peers already heard; it just finds nothing new this time.
    def rescan():
        try:
            now = peers()
        except HelperFailed:
            return []
        for m, r in now:
            rssi_of.setdefault(m, r)
        return [m for m, _ in now]

    nobody = ("no devices found: nothing nearby is advertising. "
              "A window has to be open for the peer watcher to fill this.")
    if args.list:
        # With names and a wake, an empty table is where the lookup starts.
        if not heard and not (args.names and args.wake):
            print(nobody)
            return 1

        def row(mac, got=None, named=False):
            line = f"{mac}  {signal(rssi_of.get(mac))}  [{link_local(mac)}%{IFACE}]:{PORTS.get(mac, args.port)}"
            if named:
                # Three outcomes, three words. A blank column would make
                # "not receiving" and "would not say" look identical, and only
                # one of them means you cannot send right now.
                #
                # "(no response)", not "(not receiving)": all we observe is
                # that nothing answered on the AirDrop port, and the causes are
                # not distinguishable from here. A device that is not receiving
                # produces this, but so does one mid-restart of its Bonjour
                # server, and claiming to know which would be inventing a
                # diagnosis out of a timeout.
                line += f"  {got if got else '(anonymous)' if got == '' else '(no response)'}"
            return line

        if not args.names:
            for mac, _ in heard:
                print(row(mac))
            return 0

        # --stream prints each row the moment its answer is in. Without it the
        # whole listing comes at the end, in signal order, as it always has.
        report = (lambda m, n: print(row(m, n, True), flush=True)) if args.stream else None
        names = peer_names([m for m, _ in heard], args.port, args.name, args.wake,
                           on_result=report, rescan=rescan)
        if not names:
            print(nobody)
            return 1
        if not args.stream:
            order = [m for m, _ in heard] + [m for m in names if m not in dict(heard)]
            for mac in order:
                print(row(mac, names.get(mac), True))
        return 0

    if not args.files and not args.url:
        ap.error("a file or --url is required unless --list")
    if args.files and args.url:
        ap.error("send links and files separately: a transfer carries one or the other")
    if args.mac:
        want = args.mac.lower()
        known = [m for m, _ in heard]
        # An address carries a colon, or is a full 12-hex MAC. Anything else is
        # a name -- and the test has to be that strict, because real device
        # names are often pure hex: "f0011" is a machine here, and treating it
        # as an address fragment would silently target the wrong device.
        #
        # A person sending a file knows who they are sending to, not what MAC
        # that device is wearing this minute; the MAC rotates every few
        # minutes, so it is the worse handle of the two.
        if ":" in want or re.fullmatch(r"[0-9a-f]{12}", want):
            matches = [m for m in known if want in m]
        else:
            # Asking costs a connection per peer, which is why the listing
            # makes it opt-in. Here it is not optional: resolving the name IS
            # the request. It also works precisely when it matters, because a
            # device can only receive the file if it is already listening.
            names = peer_names(known, args.port, args.name, args.wake, rescan=rescan)
            matches = [m for m, n in names.items() if n and want in n.lower()]
            if not matches:
                named = {m: n for m, n in names.items() if n}
                print(f'no device answering to "{args.mac}" is receiving right now.', file=sys.stderr)
                if named:
                    print("  these named themselves:", file=sys.stderr)
                    for m, n in named.items():
                        print(f"    {n}  ({m})", file=sys.stderr)
                else:
                    print("  no peer would give a name: a device is named only while it is "
                          "receiving, so open AirDrop on it first.", file=sys.stderr)
                return 2
        if len(matches) > 1:
            print(f'"{args.mac}" matches more than one device:', file=sys.stderr)
            for m in matches:
                print(f"    {m}", file=sys.stderr)
            return 2
        if not matches:
            print(f"{args.mac} is not in the peer table; --list shows what is", file=sys.stderr)
            return 2
        mac = matches[0]
    elif len(heard) == 1:
        mac = heard[0][0]
    elif not heard:
        print(nobody, file=sys.stderr)
        return 2
    else:
        print("several peers heard; choose one with --mac:", file=sys.stderr)
        for m, rssi in heard:
            print(f"  {m}  {signal(rssi)}", file=sys.stderr)
        return 2

    def command(port):
        # "--" so a file whose name begins with a dash is a file, not an option.
        return [sys.executable, SENDER, "--direct", f"[{link_local(mac)}%{IFACE}]:{port}",
                "--op-timeout", str(args.op_timeout), "--name", args.name,
                *(a for u in args.url for a in ("--url", u)), "--", *args.files]

    port = PORTS.get(mac, args.port)
    if args.show:
        print(" ".join(command(port)))
        return 0

    # An iPhone does not keep an AirDrop server listening while it is merely
    # discoverable: measured 2026-09-18, port 8770 refused instantly, was OPEN
    # for seconds around other sharingd work, and was gone again a minute
    # later. Two transfers landed by firing inside that window. A Mac in
    # Everyone mode listens throughout and needs none of this.
    #
    # Waiting alone relied on something else waking the phone: the radar's
    # name lookups do, but they stop when the panel closes, and choosing a file
    # closes it. So the wait raises the same wake the lookups use, for as long
    # as it waits, and stops it before the transfer starts.
    #
    # A peer that announced its own port (Android's Quick Share) is the
    # exception: it shuts its receiver ten seconds after the wake stops and the
    # person has to accept the file on it, so its wake runs until the sender
    # exits, open port or not.
    announced = mac in PORTS
    with contextlib.ExitStack() as send:
        if args.wake and announced:
            send.enter_context(wake(args.wait + SEND_WAKE_SECONDS, "sending without a wake"))
        if args.wait > 0 and not listening(link_local(mac), port):
            print(f"waiting up to {args.wait:.0f}s for {mac} to start listening on "
                  f"{port}", file=sys.stderr)
            opened = False
            with contextlib.ExitStack() as stack:
                if args.wake and not announced:
                    stack.enter_context(wake(args.wait, "waiting without a wake"))
                deadline = time.monotonic() + args.wait
                reread = time.monotonic() + RESCAN_SECONDS
                while time.monotonic() < deadline:
                    if listening(link_local(mac), port):
                        opened = True
                        break
                    time.sleep(1.0)
                    # A peer's port and the peer itself reach the table in
                    # either order, so one heard without a port may get one.
                    if announced or time.monotonic() < reread:
                        continue
                    reread = time.monotonic() + RESCAN_SECONDS
                    try:
                        peers()
                    except HelperFailed:
                        continue
                    if mac in PORTS:
                        announced, port = True, PORTS[mac]
                        print(f"{mac} announced port {port}", file=sys.stderr)
                        if args.wake:
                            stack.close()        # one advert at a time
                            send.enter_context(wake(deadline - time.monotonic() + SEND_WAKE_SECONDS,
                                                    "sending without a wake"))
            if not opened:
                print(f"{mac} never opened {port}; its AirDrop receiver has to be open "
                      f"(on an iPhone, open a share sheet or receive something to wake "
                      f"sharingd)", file=sys.stderr)
                return 3

        cmd = command(port)
        items = args.url or args.files
        what = items[0] if len(items) == 1 else (f"{len(items)} links" if args.url else f"{len(items)} files")
        print(f"sending {what} to {mac} at {cmd[3]}", file=sys.stderr)
        return subprocess.run(cmd).returncode


if __name__ == "__main__":
    sys.exit(main())
