# Maintainer: T4T5 <t4t5@hey.com>

# owly: AirDrop's radio on Linux Wi-Fi cards without Apple's Broadcom
# firmware. owlyd, the system service that leases the radio out over D-Bus,
# and the owly CLI: doctor, test-card, send and receive.
#
# Build this checkout:  makepkg -si  (here, in packaging/arch/owly)
#
# packaging/arch/aur.sh derives the AUR's PKGBUILD from this one, building
# the release tagged v${pkgver} instead of this checkout. Bumping the
# workspace version in Cargo.toml, and pkgver here, in omdrop-owl's and in
# omdrop-owl-bin's with it, publishes it (.github/workflows/release.yml).
pkgname=owly
pkgver=0.4.2
pkgrel=1
pkgdesc="AirDrop's Wi-Fi radio on Linux: AWDL in userspace, the owlyd radio service, and the owly CLI"
arch=('x86_64' 'aarch64')
url="https://github.com/t4t5/owly"
license=('MIT')
# Programs owlyd and the CLI run, by package:
#   networkmanager  nmcli: releasing and reconnecting the station
#   iproute2        ip: shared mode's check that Wi-Fi passes traffic
#   iputils         ping: the same check, test-card's Wi-Fi watch
#   util-linux      mount: debugfs, for mt76 power management
depends=('glibc' 'gcc-libs' 'dbus' 'systemd' 'polkit' 'networkmanager' 'iproute2' 'iputils' 'util-linux')
optdepends=('hostapd: exclusive mode on cards without ad-hoc mode'
            'bluez: owly send wakes the receiver over Bluetooth')
makedepends=('cargo')
checkdepends=('dbus')
options=('!lto' '!debug')
install="${pkgname}.install"

source=()
sha256sums=()

# The tree to build: this checkout.
_tree() { cd "${startdir}/../../.." && pwd; } # aur: tree
_unpack() { :; } # aur: unpack

_target() { rustc -vV | sed -n 's/^host: //p'; }

# As omdrop-core's PKGBUILD does: keep the builder's paths out of the
# binaries (panic locations, file!()), so the build doesn't depend on where
# it ran. rustc applies the last matching mapping, so srcdir, which may sit
# inside the tree, comes after it.
_cargo_env() {
  export CARGO_HOME="${srcdir}/cargo-home" CARGO_TARGET_DIR="${srcdir}/target"
  local sysroot; sysroot=$(rustc --print sysroot)
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${sysroot}=/usr/src/rust --remap-path-prefix=$(_tree)=/usr/src/debug/${pkgname} --remap-path-prefix=${srcdir}=/usr/src/debug/${pkgname}"
}

prepare() {
  _unpack
  local tree; tree=$(_tree)
  grep -qx "version = \"${pkgver}\"" "${tree}/Cargo.toml" \
    || { error "pkgver differs from the workspace version in Cargo.toml"; return 1; }

  cd "${tree}"
  export CARGO_HOME="${srcdir}/cargo-home"
  cargo fetch --locked --target "$(_target)"
}

build() {
  cd "$(_tree)"
  _cargo_env
  cargo build --frozen --release -p owlyd -p owly-cli
}

check() {
  cd "$(_tree)"
  _cargo_env
  cargo test --frozen --release -p owlyd -p owly-cli
}

package() {
  cd "$(_tree)"
  DESTDIR="${pkgdir}" TARGET="${srcdir}/target" packaging/install.sh owly
}
